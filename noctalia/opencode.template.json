{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "primary": "{{colors.primary.default.hex}}",
    "on_primary": "{{colors.on_primary.default.hex}}",
    "secondary": "{{colors.secondary.default.hex}}",
    "on_secondary": "{{colors.on_secondary.default.hex}}",
    "tertiary": "{{colors.tertiary.default.hex}}",
    "on_tertiary": "{{colors.on_tertiary.default.hex}}",
    "primary_container": "{{colors.primary_container.default.hex}}",
    "secondary_container": "{{colors.secondary_container.default.hex}}",
    "tertiary_container": "{{colors.tertiary_container.default.hex}}",
    "surface": "{{colors.surface.default.hex}}",
    "surface_container": "{{colors.surface_container.default.hex}}",
    "surface_container_high": "{{colors.surface_container_high.default.hex}}",
    "on_surface": "{{colors.on_surface.default.hex}}",
    "outline": "{{colors.outline.default.hex}}",
    "error": "{{colors.error.default.hex}}",
    "on_error": "{{colors.on_error.default.hex}}"
  },
  "theme": {
    "primary": "primary",
    "secondary": "secondary",
    "accent": "tertiary",
    "error": "error",
    "warning": "tertiary",
    "success": "tertiary",
    "info": "primary",
    "text": "on_surface",
    "textMuted": "on_surface",
    "background": "surface",
    "backgroundPanel": "surface_container",
    "backgroundElement": "surface_container_high",
    "border": "outline",
    "borderActive": "primary",
    "borderSubtle": "surface_container_high",
    "diffAdded": "tertiary",
    "diffRemoved": "error",
    "diffContext": "on_surface",
    "diffHunkHeader": "on_surface",
    "diffHighlightAdded": "tertiary",
    "diffHighlightRemoved": "error",
    "diffAddedBg": "surface_container",
    "diffRemovedBg": "surface_container",
    "diffContextBg": "surface_container",
    "diffLineNumber": "outline",
    "diffAddedLineNumberBg": "surface_container",
    "diffRemovedLineNumberBg": "surface_container",
    "markdownText": "on_surface",
    "markdownHeading": "primary",
    "markdownLink": "primary",
    "markdownLinkText": "tertiary",
    "markdownCode": "tertiary",
    "markdownBlockQuote": "on_surface",
    "markdownEmph": "tertiary",
    "markdownStrong": "on_surface",
    "markdownHorizontalRule": "outline",
    "markdownListItem": "primary",
    "markdownListEnumeration": "tertiary",
    "markdownImage": "primary",
    "markdownImageText": "tertiary",
    "markdownCodeBlock": "on_surface",
    "syntaxComment": "outline",
    "syntaxKeyword": "secondary",
    "syntaxFunction": "primary",
    "syntaxVariable": "on_surface",
    "syntaxString": "tertiary",
    "syntaxNumber": "tertiary",
    "syntaxType": "tertiary",
    "syntaxOperator": "primary",
    "syntaxPunctuation": "on_surface"
  }
}
