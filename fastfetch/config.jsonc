// execute with: fastfetch --colors-block-range-start 9 --colors-block-width 3

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
     "source": "/home/za/Downloads/logo.txt",
   //     "source":"cachyos",
    //    "type": "small",
        "padding": {
            "top": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
	"break",
	"break",
	{
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "blue",
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "magenta",
        },
             {
            "type": "shell",
            "key": " ",
            "keyColor": "green",
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "cyan",
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "yellow",
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "red",
        },
	{
            "type": "packages",
	    "disabled": ["flatpak"],
             "key": " ",
            "keyColor": "white",
        },
]
}
